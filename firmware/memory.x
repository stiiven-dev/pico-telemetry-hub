MEMORY
{
    BOOT2 : ORIGIN = 0x10000000, LENGTH = 0x100
    FLASH : ORIGIN = 0x10000100, LENGTH = 0x1FDF00
    STORAGE : ORIGIN = 0x101FE000, LENGTH = 0x2000
    RAM   : ORIGIN = 0x20000000, LENGTH = 0x3FC00
    PANDUMP : ORIGIN = 0x2003FC00, LENGTH = 0x400
}

EXTERN(BOOT2_FIRMWARE)

SECTIONS
{
    .boot2 ORIGIN(BOOT2) :
    {
        KEEP(*(.boot2));
    } > BOOT2
} INSERT BEFORE .text;

_panic_dump_start = ORIGIN(PANDUMP);
_panic_dump_end   = ORIGIN(PANDUMP) + LENGTH(PANDUMP);